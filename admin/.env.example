# Build-time variables for the admin app (Vite inlines VITE_* into the bundle,
# so never put a secret here).

# Origin of the Express API. Empty means "same origin", which is right for
# local dev (Vite proxies /api to :3000) and for the transitional single-service
# deployment. Standalone production: https://api.camulaw.com
VITE_API_BASE_URL=

# Base path the build is served from. '/' for admin.camulaw.com, '/admin/' for
# the transitional single-service deployment under camulaw.com/admin.
ADMIN_BASE=/

# Runtime variables for server.js (the static host for the built bundle).
# API origin allowed in the Content-Security-Policy connect-src.
API_ORIGIN=https://api.camulaw.com
PORT=4174
