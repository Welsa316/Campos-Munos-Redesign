{
  "name": "campos-munos-desktop",
  "productName": "Campos Muños",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop app for the Campos Muños staff portal (admin.camulaw.com), with notifications from the app itself.",
  "author": "Campos Muños",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:local": "CM_PORTAL_URL=http://localhost:5420 CM_API_URL=http://localhost:3410 electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist:mac": "electron-builder --mac --universal",
    "dist:win": "electron-builder --win --x64",
    "icons": "sh scripts/make-icons.sh"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.camulaw.portal",
    "productName": "Campos Munos",
    "artifactName": "Campos-Munos-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*.js",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "CFBundleDisplayName": "Campos Muños"
      }
    },
    "dmg": {
      "title": "Campos Muños"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Campos Muños",
      "uninstallDisplayName": "Campos Muños"
    },
    "publish": null
  }
}
