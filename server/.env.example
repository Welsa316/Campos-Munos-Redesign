DATABASE_URL=postgresql://user:password@localhost:5432/campos_munos
JWT_SECRET=change-me-to-a-random-64-char-string
# Staff portal origin(s), comma-separated. Get credentialed CORS and are the
# only origins allowed to write with the session cookie. FRONTEND_URL is the
# original name and is still honoured. Production: https://admin.camulaw.com
ADMIN_ORIGINS=http://localhost:5175
FRONTEND_URL=
# Public website origin(s), comma-separated. CORS for the contact form and
# chat, never with credentials. Production: https://camulaw.com,https://www.camulaw.com
PUBLIC_ORIGINS=http://localhost:5174
ADMIN_EMAIL=admin@camulaw.com
ADMIN_INITIAL_PASSWORD=changeme
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=contact@camulaw.com
PORT=3000
# REQUIRED in production. Secure cookies, DB SSL, and the admin-seed guard all
# key off this being exactly "production". If unset on the live host, login
# cookies won't be secure and the seed falls back to defaults. Set it on Railway.
NODE_ENV=production

# Meta WhatsApp Cloud API webhook (receiving only — see docs/whatsapp-webhook.md).
# WHATSAPP_VERIFY_TOKEN: a random string of at least 16 chars (openssl rand -hex 32);
#   paste the same value into Meta App Dashboard > WhatsApp > Configuration >
#   Webhook "Verify token". Placeholder or short values are refused.
# META_APP_SECRET: Meta App Dashboard > App settings > Basic > App secret. Used
#   to check the X-Hub-Signature-256 header; the webhook refuses every POST
#   until it is set.
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-64-char-string
META_APP_SECRET=

# --- Split deployment (docs/architecture-split.md) ---

# Session cookie SameSite. 'lax' (default) is right whenever portal and API
# share a registrable domain (admin.camulaw.com / api.camulaw.com). Use 'none'
# only for staging on *.up.railway.app, where they are cross-site; it forces
# Secure.
COOKIE_SAMESITE=lax

# Same value as on the website service while its cutover proxy is enabled.
# Without it, X-CM-Client-IP from the proxy is ignored. openssl rand -hex 32
SITE_PROXY_SECRET=

# 'false' turns off serving site/dist and admin/dist from this process. They
# are only served when those builds exist beside server/ (the transitional
# single-service deployment); a standalone API deployment has neither.
SERVE_FRONTENDS=
