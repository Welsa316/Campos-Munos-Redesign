DATABASE_URL=postgresql://user:password@localhost:5432/campos_munos
JWT_SECRET=change-me-to-a-random-64-char-string
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@camulaw.com
ADMIN_INITIAL_PASSWORD=changeme
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=contact@camulaw.com
PORT=3000
# REQUIRED in production. Secure cookies, DB SSL, and the admin-seed guard all
# key off this being exactly "production". If unset on the live host, login
# cookies won't be secure and the seed falls back to defaults. Set it on Railway.
NODE_ENV=production

# Meta WhatsApp Cloud API webhook (receiving only — see docs/whatsapp-webhook.md).
# WHATSAPP_VERIFY_TOKEN: a random string of at least 16 chars (openssl rand -hex 32);
#   paste the same value into Meta App Dashboard > WhatsApp > Configuration >
#   Webhook "Verify token". Placeholder or short values are refused.
# META_APP_SECRET: Meta App Dashboard > App settings > Basic > App secret. Used
#   to check the X-Hub-Signature-256 header; the webhook refuses every POST
#   until it is set.
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-64-char-string
META_APP_SECRET=
