# --- Build time (Vite inlines VITE_* into the public bundle: never a secret) ---

# Origin of the API. Empty = same origin (local dev, where Vite proxies /api,
# and the transitional single-service deployment).
# Standalone production: https://api.camulaw.com
VITE_API_BASE_URL=

# --- Runtime (site/server/index.js) ---

PORT=4173

# Staff portal origin. When set, /admin and /admin/* answer 302 to the same
# path on the portal. Production: https://admin.camulaw.com
ADMIN_URL=

# API origin added to the CSP connect-src, so the contact form and chat can
# post to it. Production: https://api.camulaw.com
API_ORIGIN=

# Cutover proxy (temporary). When set, /api/* and /webhooks/* are forwarded to
# this origin, so tabs still running the previous bundle and WhatsApp webhooks
# addressed to camulaw.com keep working after DNS moves. Unset it once traffic
# to those paths has stopped. Production during cutover: https://api.camulaw.com
API_PROXY_TARGET=

# Shared with the API service (same value on both). Lets the proxy pass the
# visitor's IP so the API rate-limits per visitor, not per proxy.
# openssl rand -hex 32
SITE_PROXY_SECRET=
